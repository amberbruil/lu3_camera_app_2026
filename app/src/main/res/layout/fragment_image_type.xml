<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nocturne_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- kicker -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="22dp"
                android:layout_height="2dp"
                android:layout_marginEnd="10dp"
                android:background="@color/nocturne_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="@string/gallery_kicker"
                android:textAllCaps="true"
                android:textColor="@color/nocturne_accent_300"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/gallery_title"
            android:textColor="@color/nocturne_text"
            android:textSize="30sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:lineSpacingExtra="4sp"
            android:text="@string/gallery_subtitle"
            android:textColor="@color/nocturne_muted"
            android:textSize="14sp" />

        <!-- Local images -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLocal"
            style="@style/Nocturne.Card.Source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_icon_tile"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:src="@drawable/ic_device_mobile"
                    app:tint="@color/nocturne_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/source_local"
                        android:textColor="@color/nocturne_text"
                        android:textSize="16sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_caret_right"
                    app:tint="@color/nocturne_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cloud images -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCloud"
            style="@style/Nocturne.Card.Source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_icon_tile"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:src="@drawable/ic_cloud_download"
                    app:tint="@color/nocturne_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/source_cloud"
                        android:textColor="@color/nocturne_text"
                        android:textSize="16sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_caret_right"
                    app:tint="@color/nocturne_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recent -->

    </LinearLayout>
</LinearLayout>
