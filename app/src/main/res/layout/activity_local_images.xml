<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/view_gallery_actions.xml
     Standalone View / Add action pair. Drop it into any layout with:
       <include layout="@layout/view_gallery_actions" />
     Requires com.google.android.material:material:1.12.0 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nocturne_bg"
    android:baselineAligned="false"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp">

    <Space
        android:layout_width="match_parent"
        android:layout_height="58dp" />

    <LinearLayout
        android:layout_width="370dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnView"
            style="@style/Nocturne.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:text="@string/action_view"
            app:icon="@drawable/ic_eye"
            app:iconGravity="textStart"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            style="@style/Nocturne.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:text="@string/action_add"
            app:icon="@drawable/ic_briefcase"
            app:iconGravity="textStart"
            app:iconSize="18dp" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainerView2"
        android:layout_width="367dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" />

</LinearLayout>
